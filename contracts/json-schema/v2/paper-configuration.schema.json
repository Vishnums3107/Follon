{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://follon.dev/contracts/v2/paper-configuration.schema.json",
  "title": "Follon Paper Operations Configuration v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "configuration_id", "configuration_version", "account", "adapter", "risk", "kill_switch_version"],
  "properties": {
    "schema_version": { "const": 2 },
    "configuration_id": { "$ref": "#/$defs/canonicalId" },
    "configuration_version": { "type": "string", "minLength": 1 },
    "account": { "$ref": "#/$defs/account" },
    "adapter": { "$ref": "#/$defs/adapterRoute" },
    "risk": { "$ref": "#/$defs/risk" },
    "kill_switch_version": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "canonicalId": { "type": "string", "pattern": "^[a-z0-9._-]+$", "minLength": 1 },
    "decimal": { "type": "string", "pattern": "^-?[0-9]+(?:\\.[0-9]{1,8})?$" },
    "positiveDecimal": { "type": "string", "pattern": "^(?=[0-9]+(?:\\.[0-9]{1,8})?$)(?:[0-9]*[1-9][0-9]*(?:\\.[0-9]+)?|[0-9]+\\.[0-9]*[1-9][0-9]*)$" },
    "basisPoints": { "type": "string", "pattern": "^(?:0|[1-9][0-9]{0,3})(?:\\.[0-9]{1,8})?$" },
    "account": {
      "type": "object",
      "additionalProperties": false,
      "required": ["account_id", "currency", "initial_cash", "environment"],
      "properties": {
        "account_id": { "$ref": "#/$defs/canonicalId" },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "initial_cash": { "$ref": "#/$defs/decimal" },
        "environment": { "const": "PAPER" }
      }
    },
    "adapterRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter_id", "venue_id", "environment"],
      "properties": {
        "adapter_id": { "$ref": "#/$defs/canonicalId" },
        "venue_id": { "$ref": "#/$defs/canonicalId" },
        "environment": { "const": "PAPER" }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_version", "trading_calendar_id", "max_order_quantity", "max_order_notional", "max_price_deviation_bps", "max_open_orders", "max_position_quantity", "max_realized_loss", "max_market_data_age_seconds"],
      "properties": {
        "policy_version": { "type": "string", "minLength": 1 },
        "trading_calendar_id": { "$ref": "#/$defs/canonicalId" },
        "max_order_quantity": { "$ref": "#/$defs/positiveDecimal" },
        "max_order_notional": { "$ref": "#/$defs/positiveDecimal" },
        "max_price_deviation_bps": { "$ref": "#/$defs/basisPoints" },
        "max_open_orders": { "type": "integer", "minimum": 1 },
        "max_position_quantity": { "$ref": "#/$defs/positiveDecimal" },
        "max_realized_loss": { "$ref": "#/$defs/decimal" },
        "max_market_data_age_seconds": { "type": "integer", "minimum": 1, "maximum": 86400 }
      }
    }
  }
}

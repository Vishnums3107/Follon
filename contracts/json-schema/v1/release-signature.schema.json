{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://follon.dev/contracts/v1/release-signature.schema.json",
  "title": "Follon Detached Ed25519 Release Signature v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["release_signature_schema_version", "release_id", "manifest_hash", "key_id", "signature_hex", "signed_at"],
  "properties": {
    "release_signature_schema_version": { "const": 1 },
    "release_id": { "$ref": "#/$defs/id" },
    "manifest_hash": { "$ref": "#/$defs/hash" },
    "key_id": { "$ref": "#/$defs/id" },
    "signature_hex": { "type": "string", "pattern": "^[a-f0-9]{128}$" },
    "signed_at": { "$ref": "#/$defs/utc" }
  },
  "$defs": { "id": { "type": "string", "pattern": "^[a-z0-9._-]+$", "minLength": 1 }, "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" } }
}

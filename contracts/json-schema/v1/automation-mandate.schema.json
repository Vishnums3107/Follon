{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AutomationMandate",
  "description": "Bounded research automation mandate specifying permitted experiment templates, tool access, CPU/time/spend limits, and approval policies without broker access (AI-04).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mandate_schema_version",
    "mandate_id",
    "owner",
    "allowed_tasks",
    "resource_limits",
    "cancellation_policy",
    "broker_access_permitted",
    "created_at",
    "expires_at"
  ],
  "properties": {
    "mandate_schema_version": {
      "type": "integer",
      "enum": [1]
    },
    "mandate_id": {
      "type": "string",
      "pattern": "^mandate\\.[a-z0-9_.-]+$"
    },
    "owner": {
      "type": "string"
    },
    "allowed_tasks": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "resource_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_cpu_cores", "max_memory_mb", "max_duration_seconds", "max_storage_bytes"],
      "properties": {
        "max_cpu_cores": { "type": "integer", "minimum": 1 },
        "max_memory_mb": { "type": "integer", "minimum": 128 },
        "max_duration_seconds": { "type": "integer", "minimum": 60 },
        "max_storage_bytes": { "type": "integer", "minimum": 1048576 }
      }
    },
    "cancellation_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stop_on_first_error", "checkpoint_interval_seconds"],
      "properties": {
        "stop_on_first_error": { "type": "boolean" },
        "checkpoint_interval_seconds": { "type": "integer", "minimum": 10 }
      }
    },
    "broker_access_permitted": {
      "type": "boolean",
      "enum": [false]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}

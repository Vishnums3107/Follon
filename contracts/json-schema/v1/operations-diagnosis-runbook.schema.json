{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OperationsDiagnosisRunbook",
  "description": "Evidence-grounded operations diagnosis and idempotent repair runbook proposal for non-trading system incidents (AI-05).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "diagnosis_schema_version",
    "diagnosis_id",
    "incident_id",
    "failing_component",
    "root_cause_summary",
    "cited_evidence_ids",
    "proposed_runbook_steps",
    "idempotency_certified",
    "trading_path_isolated",
    "approval_required",
    "created_at"
  ],
  "properties": {
    "diagnosis_schema_version": {
      "type": "integer",
      "enum": [1]
    },
    "diagnosis_id": {
      "type": "string",
      "pattern": "^diag\\.ops\\.[a-z0-9_.-]+$"
    },
    "incident_id": {
      "type": "string"
    },
    "failing_component": {
      "type": "string"
    },
    "root_cause_summary": {
      "type": "string"
    },
    "cited_evidence_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "proposed_runbook_steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step_number", "action_name", "target_service", "command_template", "is_idempotent"],
        "properties": {
          "step_number": { "type": "integer", "minimum": 1 },
          "action_name": { "type": "string" },
          "target_service": { "type": "string" },
          "command_template": { "type": "string" },
          "is_idempotent": { "type": "boolean" }
        }
      }
    },
    "idempotency_certified": {
      "type": "boolean"
    },
    "trading_path_isolated": {
      "type": "boolean"
    },
    "approval_required": {
      "type": "string",
      "enum": ["OPERATOR_CONFIRMATION", "AUTOMATED_IDEMPOTENT", "ESCALATION_BLOCKED"]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://follon.local/contracts/v1/external-acceptance-evidence.schema.json",
  "title": "Follon external acceptance evidence record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "acceptance_evidence_schema_version",
    "evidence_id",
    "evidence_type",
    "subject_id",
    "occurred_at",
    "observed_by",
    "reviewed_by",
    "source_artifact_sha256",
    "outcome",
    "notes",
    "prev_hash",
    "record_hash"
  ],
  "properties": {
    "acceptance_evidence_schema_version": { "const": 1 },
    "evidence_id": { "type": "string", "pattern": "^[a-z0-9._-]+$" },
    "evidence_type": {
      "enum": ["paper_session", "live_session", "design_partner", "broker_options", "paying_customer"]
    },
    "subject_id": { "type": "string", "pattern": "^[a-z0-9._-]+$" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "observed_by": { "type": "string", "pattern": "^[a-z0-9._-]+$" },
    "reviewed_by": { "type": "string", "pattern": "^[a-z0-9._-]+$" },
    "source_artifact_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "outcome": { "enum": ["accepted", "rejected"] },
    "notes": { "type": "string", "maxLength": 1024 },
    "prev_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "record_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}

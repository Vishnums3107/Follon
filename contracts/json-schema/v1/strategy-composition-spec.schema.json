{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StrategyCompositionSpec",
  "description": "Strategy composition specification containing declarative signals, sizing rules, entry/exit criteria, and portfolio constraints sharing code and visual representation (RES-02).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "composition_schema_version",
    "composition_id",
    "strategy_id",
    "strategy_version",
    "signals",
    "sizing_rule",
    "entry_criteria",
    "exit_criteria",
    "portfolio_constraints",
    "code_hash",
    "visual_representation_hash",
    "created_at"
  ],
  "properties": {
    "composition_schema_version": {
      "type": "integer",
      "enum": [1]
    },
    "composition_id": {
      "type": "string",
      "pattern": "^comp\\.strat\\.[a-z0-9_.-]+$"
    },
    "strategy_id": {
      "type": "string"
    },
    "strategy_version": {
      "type": "string"
    },
    "signals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["signal_id", "indicator_ref", "condition", "weight_bps"],
        "properties": {
          "signal_id": { "type": "string" },
          "indicator_ref": { "type": "string" },
          "condition": { "type": "string" },
          "weight_bps": { "type": "integer", "minimum": 0, "maximum": 10000 }
        }
      }
    },
    "sizing_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sizing_type", "target_value"],
      "properties": {
        "sizing_type": {
          "type": "string",
          "enum": ["FIXED_CAPITAL", "VOLATILITY_TARGETED", "RISK_PARITY", "KELLY_FRACTION"]
        },
        "target_value": { "type": "string" }
      }
    },
    "entry_criteria": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "exit_criteria": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "portfolio_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_leverage_bps", "max_single_position_bps", "stop_loss_pct"],
      "properties": {
        "max_leverage_bps": { "type": "integer", "minimum": 0 },
        "max_single_position_bps": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "stop_loss_pct": { "type": "string" }
      }
    },
    "code_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "visual_representation_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}

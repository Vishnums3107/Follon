{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://follon.dev/contracts/v1/commercial-data-inventory.schema.json",
  "title": "Follon Privacy and Retention Data Inventory v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["data_inventory_schema_version", "tenant_id", "assets"],
  "properties": {
    "data_inventory_schema_version": { "const": 1 },
    "tenant_id": { "$ref": "#/$defs/id" },
    "assets": { "type": "array", "items": { "$ref": "#/$defs/asset" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9._-]+$", "minLength": 1 },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "relativePath": { "type": "string", "pattern": "^(?!.*(?:^|[\\/])\\.{1,2}(?:[\\/]|$))(?![\\/])[A-Za-z0-9._/-]+$", "minLength": 1, "maxLength": 4096 },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "tenant_id", "relative_path", "classification", "created_at", "retain_until", "subject_hashes", "legal_hold"],
      "properties": {
        "asset_id": { "$ref": "#/$defs/id" },
        "tenant_id": { "$ref": "#/$defs/id" },
        "relative_path": { "$ref": "#/$defs/relativePath" },
        "classification": { "enum": ["CUSTOMER_CONTENT", "OPERATIONAL_METADATA", "MARKET_DATA", "AUDIT_EVIDENCE"] },
        "created_at": { "$ref": "#/$defs/utc" },
        "retain_until": { "$ref": "#/$defs/utc" },
        "subject_hashes": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/hash" } },
        "legal_hold": { "type": "boolean" }
      }
    }
  }
}

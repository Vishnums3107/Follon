{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CapitalAllocationProposal",
  "description": "Council-evaluated capital allocation proposal with volatility targeting, diversification benefits, and drawdown limits (DUR-11).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "proposal_schema_version",
    "proposal_id",
    "total_equity_usd",
    "target_annual_volatility_bps",
    "max_drawdown_limit_bps",
    "allocations",
    "portfolio_diversification_ratio_bps",
    "proposal_status",
    "policy_version",
    "proposed_at"
  ],
  "properties": {
    "proposal_schema_version": {
      "type": "integer",
      "enum": [1]
    },
    "proposal_id": {
      "type": "string",
      "pattern": "^cap-prop\\.[a-z0-9_.-]+$"
    },
    "total_equity_usd": { "type": "string" },
    "target_annual_volatility_bps": { "type": "integer", "minimum": 0 },
    "max_drawdown_limit_bps": { "type": "integer", "minimum": 0, "maximum": 10000 },
    "allocations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "strategy_id",
          "recommended_capital_usd",
          "risk_budget_share_bps",
          "marginal_risk_contribution_bps"
        ],
        "properties": {
          "strategy_id": { "type": "string" },
          "recommended_capital_usd": { "type": "string" },
          "risk_budget_share_bps": { "type": "integer", "minimum": 0, "maximum": 10000 },
          "marginal_risk_contribution_bps": { "type": "integer" }
        }
      }
    },
    "portfolio_diversification_ratio_bps": { "type": "integer", "minimum": 0 },
    "proposal_status": {
      "type": "string",
      "enum": ["RECOMMENDED", "UNDER_REVIEW", "RATIFIED", "REJECTED"]
    },
    "policy_version": { "type": "string" },
    "proposed_at": { "type": "string", "format": "date-time" }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://follon.dev/contracts/v1/fx-pricing-snapshot.schema.json",
  "title": "Follon FX Pricing Snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "snapshot_id", "reference_version", "instrument_id", "product", "base_currency", "quote_currency", "terms", "source_id", "source_sequence", "source_time", "received_at"],
  "properties": {
    "schema_version": { "const": 1 },
    "snapshot_id": { "$ref": "#/$defs/canonicalId" },
    "reference_version": { "$ref": "#/$defs/canonicalId" },
    "instrument_id": { "$ref": "#/$defs/canonicalId" },
    "product": { "enum": ["FX_SPOT", "FX_FORWARD", "FX_SWAP"] },
    "base_currency": { "$ref": "#/$defs/currency" },
    "quote_currency": { "$ref": "#/$defs/currency" },
    "terms": { "$ref": "#/$defs/terms" },
    "source_id": { "$ref": "#/$defs/canonicalId" },
    "source_sequence": { "type": "integer", "minimum": 0 },
    "source_time": { "$ref": "#/$defs/utc" },
    "received_at": { "$ref": "#/$defs/utc" }
  },
  "allOf": [
    {
      "if": { "properties": { "product": { "enum": ["FX_SPOT", "FX_FORWARD"] } }, "required": ["product"] },
      "then": { "properties": { "terms": { "$ref": "#/$defs/outrightTerms" } } }
    },
    {
      "if": { "properties": { "product": { "const": "FX_SWAP" } }, "required": ["product"] },
      "then": { "properties": { "terms": { "$ref": "#/$defs/swapTerms" } } }
    }
  ],
  "$defs": {
    "canonicalId": { "type": "string", "pattern": "^[a-z0-9._-]+$", "minLength": 1 },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "decimal": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]{1,8})?$" },
    "utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "valueDate": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "outrightTerms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value_date", "bid", "ask"],
      "properties": {
        "value_date": { "$ref": "#/$defs/valueDate" },
        "bid": { "$ref": "#/$defs/decimal" },
        "ask": { "$ref": "#/$defs/decimal" }
      }
    },
    "swapTerms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["near_value_date", "far_value_date", "near_bid", "near_ask", "far_bid", "far_ask"],
      "properties": {
        "near_value_date": { "$ref": "#/$defs/valueDate" },
        "far_value_date": { "$ref": "#/$defs/valueDate" },
        "near_bid": { "$ref": "#/$defs/decimal" },
        "near_ask": { "$ref": "#/$defs/decimal" },
        "far_bid": { "$ref": "#/$defs/decimal" },
        "far_ask": { "$ref": "#/$defs/decimal" }
      }
    },
    "terms": { "oneOf": [{ "$ref": "#/$defs/outrightTerms" }, { "$ref": "#/$defs/swapTerms" }] }
  }
}

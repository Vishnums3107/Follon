{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://follon.dev/contracts/v1/paper-command-route.schema.json",
  "title": "Follon PAPER Command Route Configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "account_id",
    "currency",
    "initial_cash",
    "risk_policy_version",
    "trading_calendar_id",
    "max_order_quantity",
    "max_order_notional",
    "max_price_deviation_bps",
    "max_open_orders",
    "max_position_quantity",
    "max_realized_loss",
    "max_market_data_age_seconds",
    "max_order_rate",
    "order_rate_window_seconds",
    "instrument_tick_sizes",
    "instrument_lot_sizes",
    "kill_switch_version",
    "adapter_kind",
    "journal_path"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "account_id": { "$ref": "#/$defs/canonicalId" },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "initial_cash": { "$ref": "#/$defs/decimal" },
    "risk_policy_version": { "type": "string", "minLength": 1 },
    "trading_calendar_id": { "$ref": "#/$defs/canonicalId" },
    "max_order_quantity": { "$ref": "#/$defs/positiveDecimal" },
    "max_order_notional": { "$ref": "#/$defs/positiveDecimal" },
    "max_price_deviation_bps": { "$ref": "#/$defs/basisPoints" },
    "max_open_orders": { "type": "integer", "minimum": 1 },
    "max_position_quantity": { "$ref": "#/$defs/positiveDecimal" },
    "max_realized_loss": { "$ref": "#/$defs/decimal" },
    "max_market_data_age_seconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
    "max_order_rate": { "type": "integer", "minimum": 1 },
    "order_rate_window_seconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
    "instrument_tick_sizes": { "type": "object", "minProperties": 1, "propertyNames": { "$ref": "#/$defs/canonicalId" }, "additionalProperties": { "$ref": "#/$defs/positiveDecimal" }, "description": "Venue tick size per tradable instrument. An order for an unlisted instrument, or a limit price off its instrument's grid, is refused before it can reach the broker." },
    "instrument_lot_sizes": { "type": "object", "minProperties": 1, "propertyNames": { "$ref": "#/$defs/canonicalId" }, "additionalProperties": { "$ref": "#/$defs/positiveDecimal" }, "description": "Venue lot size per tradable instrument: the exact quantity increment. An order for an unlisted instrument, or a quantity (for a combination, each leg's contract quantity) that is not a whole number of lots, is refused before it can reach the broker. It must list exactly the instruments instrument_tick_sizes lists; a configuration that lists an instrument in only one of the two tables is refused at startup." },
    "short_exposure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_short_quantity"],
      "properties": {
        "max_short_quantity": { "$ref": "#/$defs/positiveDecimal" }
      }
    },
    "portfolio_risk": { "$ref": "#/$defs/portfolioRisk", "description": "Aggregate portfolio limits: gross and net exposure, leverage, concentration, drawdown, daily loss, margin utilisation and sector, asset-class, currency and strategy buckets. The same document follon-paper-status reads. Absent, no aggregate limit applies. Present, it gates every order and combination the route accepts, and it is part of the journal's configuration fingerprint, so a journal reopens only under the limits it was written with." },
    "kill_switch_version": { "type": "string", "minLength": 1 },
    "adapter_kind": { "enum": ["IBKR_PAPER_MODEL", "IBKR_PAPER_BRIDGE"], "description": "IBKR_PAPER_MODEL is the in-process deterministic model. IBKR_PAPER_BRIDGE starts the official-API IBKR PAPER bridge process, which carries single DAY orders only: a combination, a GTC order or a replacement is refused before an order exists." },
    "ibkr_bridge": { "$ref": "#/$defs/ibkrBridge" },
    "journal_path": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    {
      "if": { "required": ["adapter_kind"], "properties": { "adapter_kind": { "const": "IBKR_PAPER_BRIDGE" } } },
      "then": { "required": ["ibkr_bridge"] },
      "else": { "not": { "required": ["ibkr_bridge"] } }
    }
  ],
  "$defs": {
    "canonicalId": { "type": "string", "pattern": "^[a-z0-9._-]+$", "minLength": 1 },
    "decimal": { "type": "string", "pattern": "^-?[0-9]+(?:\\.[0-9]{1,8})?$" },
    "positiveDecimal": { "type": "string", "pattern": "^(?=[0-9]+(?:\\.[0-9]{1,8})?$)(?:[0-9]*[1-9][0-9]*(?:\\.[0-9]+)?|[0-9]+\\.[0-9]*[1-9][0-9]*)$" },
    "basisPoints": { "type": "string", "pattern": "^(?:0|[1-9][0-9]{0,3})(?:\\.[0-9]{1,8})?$" },
    "portfolioRisk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_version",
        "max_gross_exposure",
        "max_abs_net_exposure",
        "max_leverage_bps",
        "max_concentration_bps"
      ],
      "properties": {
        "policy_version": {
          "type": "string",
          "minLength": 1
        },
        "max_gross_exposure": {
          "$ref": "#/$defs/positiveDecimal"
        },
        "max_abs_net_exposure": {
          "$ref": "#/$defs/positiveDecimal"
        },
        "max_leverage_bps": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]{0,5})(?:\\.[0-9]{1,8})?$"
        },
        "max_concentration_bps": {
          "$ref": "#/$defs/basisPoints"
        },
        "max_drawdown_bps": {
          "type": "string",
          "pattern": "^(?:10000|[0-9]{1,4})(?:\\.[0-9]{1,8})?$"
        },
        "max_daily_loss": {
          "type": "string",
          "pattern": "^[0-9]+(?:\\.[0-9]{1,8})?$"
        },
        "max_margin_utilization_bps": {
          "type": "string",
          "pattern": "^(?:10000|[0-9]{1,4})(?:\\.[0-9]{1,8})?$"
        },
        "allowed_instruments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/canonicalId"
          }
        },
        "restricted_instruments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/canonicalId"
          }
        },
        "sector_limits": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/positiveDecimal"
          }
        },
        "asset_class_limits": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/positiveDecimal"
          }
        },
        "currency_limits": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/positiveDecimal"
          }
        },
        "strategy_limits": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/positiveDecimal"
          }
        },
        "instrument_buckets": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/instrumentBucket"
          }
        },
        "margin_rates": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/marginRate"
          }
        }
      }
    },
    "instrumentBucket": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_class",
        "currency",
        "sector"
      ],
      "properties": {
        "asset_class": {
          "$ref": "#/$defs/canonicalId"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "sector": {
          "$ref": "#/$defs/canonicalId"
        }
      }
    },
    "marginRate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "initial_bps",
        "maintenance_bps"
      ],
      "properties": {
        "initial_bps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "maintenance_bps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        }
      }
    },
    "ibkrBridge": {
      "type": "object",
      "additionalProperties": false,
      "description": "How the route starts the official-API IBKR PAPER bridge. The route builds the bridge's argument list from these fields, so no free-form argument reaches the process. The broker account, client id, TWS time zone and the instrument map's SHA-256 are bound into the journal fingerprint.",
      "required": [
        "python_executable",
        "bridge_script",
        "host",
        "port",
        "client_id",
        "broker_account",
        "instrument_map",
        "tws_timezone",
        "request_timeout_seconds",
        "max_response_bytes"
      ],
      "properties": {
        "python_executable": { "type": "string", "minLength": 1, "description": "Absolute path of the approved interpreter; the process gets no PATH." },
        "bridge_script": { "type": "string", "minLength": 1, "description": "Absolute path of python/ibkr-gateway/src/follon_ibkr_gateway.py." },
        "host": { "enum": ["127.0.0.1", "localhost", "::1"] },
        "port": { "enum": [7497, 4002], "description": "The PAPER TWS (7497) or PAPER Gateway (4002) port." },
        "client_id": { "type": "integer", "minimum": 0, "maximum": 31 },
        "broker_account": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[^\\r\\n]+$", "description": "The IBKR paper account identifier: account metadata, not a credential." },
        "instrument_map": { "type": "string", "minLength": 1, "description": "A regular file of at most 1 MiB, in the bridge's instrument-map format." },
        "tws_timezone": { "type": "string", "minLength": 1, "description": "The IANA time zone TWS reports execution times in." },
        "request_timeout_seconds": { "type": "integer", "minimum": 3, "maximum": 60, "description": "The route's deadline for each bridge request. The bridge's own IBKR timeout is two seconds shorter." },
        "max_response_bytes": { "type": "integer", "minimum": 256, "maximum": 1048576 }
      }
    }
  }
}

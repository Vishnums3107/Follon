{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://follon.dev/contracts/v1/operations-schedule.schema.json",
  "title": "Follon Operations Schedule Projection v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["as_of", "configuration_content_hash", "journal", "parameter_set_fingerprint", "projection_fingerprint", "reproducibility", "schedule_schema_version", "source_fingerprint", "schedules"],
  "properties": {
    "as_of": { "$ref": "#/$defs/utc" },
    "configuration_content_hash": { "$ref": "#/$defs/hash" },
    "journal": { "$ref": "#/$defs/journal" },
    "parameter_set_fingerprint": { "$ref": "#/$defs/hash" },
    "projection_fingerprint": { "$ref": "#/$defs/hash" },
    "reproducibility": { "$ref": "#/$defs/reproducibility" },
    "schedule_schema_version": { "const": 2 },
    "source_fingerprint": { "$ref": "#/$defs/hash" },
    "schedules": { "type": "array", "items": { "$ref": "#/$defs/schedule" } }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "id": { "type": "string", "pattern": "^[a-z0-9._-]+$", "minLength": 1 },
    "journal": { "type": "object", "additionalProperties": false, "required": ["failure_reason", "head_hash", "healthy", "sequence"], "properties": { "failure_reason": { "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }] }, "head_hash": { "$ref": "#/$defs/hash" }, "healthy": { "type": "boolean" }, "sequence": { "type": "integer", "minimum": 0 } } },
    "reproducibility": { "type": "object", "additionalProperties": false, "required": ["dataset_hash", "replay_event_hash", "strategy_bundle_hash"], "properties": { "dataset_hash": { "$ref": "#/$defs/hash" }, "replay_event_hash": { "$ref": "#/$defs/hash" }, "strategy_bundle_hash": { "$ref": "#/$defs/hash" } } },
    "schedule": { "type": "object", "additionalProperties": false, "required": ["due", "enabled", "last_completed_at", "next_due_at", "purpose", "schedule_id", "time_utc"], "properties": { "due": { "type": "boolean" }, "enabled": { "type": "boolean" }, "last_completed_at": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/utc" }] }, "next_due_at": { "$ref": "#/$defs/utc" }, "purpose": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\r\\n]+$" }, "schedule_id": { "$ref": "#/$defs/id" }, "time_utc": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" } } }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://follon.dev/contracts/v1/paper-dashboard.schema.json",
  "title": "Follon Paper Operations Dashboard v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dashboard_schema_version",
    "environment",
    "account_id",
    "configuration_fingerprint",
    "broker_connected",
    "persistence_healthy",
    "audit_sequence",
    "audit_head_hash",
    "internal_cash",
    "working_orders",
    "unknown_orders",
    "active_kill_switches",
    "unexplained_incidents",
    "last_reconciled_at",
    "last_reconciliation_clean",
    "clean_paper_days",
    "required_paper_days",
    "promotion_eligible",
    "complete_auditability",
    "positions"
  ],
  "properties": {
    "dashboard_schema_version": { "const": 2 },
    "environment": { "const": "PAPER" },
    "account_id": { "$ref": "#/$defs/canonicalId" },
    "configuration_fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "broker_connected": { "type": "boolean" },
    "persistence_healthy": { "type": "boolean" },
    "audit_sequence": { "type": "integer", "minimum": 0 },
    "audit_head_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "internal_cash": { "$ref": "#/$defs/decimal" },
    "working_orders": { "type": "integer", "minimum": 0 },
    "unknown_orders": { "type": "integer", "minimum": 0 },
    "active_kill_switches": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "unexplained_incidents": { "type": "integer", "minimum": 0 },
    "last_reconciled_at": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" }
      ]
    },
    "last_reconciliation_clean": { "type": ["boolean", "null"] },
    "clean_paper_days": { "type": "integer", "minimum": 0 },
    "required_paper_days": { "const": 30 },
    "promotion_eligible": { "type": "boolean" },
    "complete_auditability": { "type": "boolean" },
    "positions": {
      "type": "array",
      "items": { "$ref": "#/$defs/position" }
    }
  },
  "$defs": {
    "canonicalId": {
      "type": "string",
      "pattern": "^[a-z0-9._-]+$",
      "minLength": 1
    },
    "decimal": {
      "type": "string",
      "pattern": "^-?[0-9]+(?:\\.[0-9]{1,8})?$"
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instrument_id", "quantity", "average_cost", "realized_pnl"],
      "properties": {
        "instrument_id": { "$ref": "#/$defs/canonicalId" },
        "quantity": { "$ref": "#/$defs/decimal" },
        "average_cost": { "$ref": "#/$defs/decimal" },
        "realized_pnl": { "$ref": "#/$defs/decimal" }
      }
    }
  }
}

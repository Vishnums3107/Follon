{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ChampionChallengerEvaluation",
  "description": "Continuous shadow evaluation comparing active champion strategies against challengers, monitoring performance drift, and issuing retirement review tasks (RES-08).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "champion_challenger_schema_version",
    "evaluation_id",
    "champion_strategy_id",
    "challenger_strategy_id",
    "evaluation_window_start",
    "evaluation_window_end",
    "champion_return_bps",
    "challenger_return_bps",
    "champion_max_drawdown_bps",
    "challenger_max_drawdown_bps",
    "information_ratio_diff_bps",
    "drift_detected",
    "recommendation",
    "created_at"
  ],
  "properties": {
    "champion_challenger_schema_version": {
      "type": "integer",
      "enum": [1]
    },
    "evaluation_id": {
      "type": "string",
      "pattern": "^eval\\.champ\\.[a-z0-9_.-]+$"
    },
    "champion_strategy_id": {
      "type": "string"
    },
    "challenger_strategy_id": {
      "type": "string"
    },
    "evaluation_window_start": {
      "type": "string",
      "format": "date-time"
    },
    "evaluation_window_end": {
      "type": "string",
      "format": "date-time"
    },
    "champion_return_bps": {
      "type": "integer"
    },
    "challenger_return_bps": {
      "type": "integer"
    },
    "champion_max_drawdown_bps": {
      "type": "integer"
    },
    "challenger_max_drawdown_bps": {
      "type": "integer"
    },
    "information_ratio_diff_bps": {
      "type": "integer"
    },
    "drift_detected": {
      "type": "boolean"
    },
    "recommendation": {
      "type": "string",
      "enum": ["RETAIN_CHAMPION", "PROMOTE_CHALLENGER", "INITIATE_RETIREMENT_REVIEW", "CONTINUE_SHADOW_MONITORING"]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}

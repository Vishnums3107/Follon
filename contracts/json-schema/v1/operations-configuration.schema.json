{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://follon.dev/contracts/v1/operations-configuration.schema.json",
  "title": "Follon Operations Workbench Configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "environment", "account", "configuration", "reproducibility", "parameters", "valuation", "positions", "risk_limits", "operational_health", "attribution_entries", "schedules"],
  "properties": {
    "schema_version": { "const": 1 },
    "environment": { "enum": ["SIMULATION", "PAPER", "LIVE"] },
    "account": { "$ref": "#/$defs/account" },
    "configuration": { "$ref": "#/$defs/configuration" },
    "reproducibility": { "$ref": "#/$defs/reproducibility" },
    "parameters": { "$ref": "#/$defs/parameters" },
    "valuation": { "$ref": "#/$defs/valuation" },
    "positions": { "type": "array", "items": { "$ref": "#/$defs/position" } },
    "risk_limits": { "$ref": "#/$defs/riskLimits" },
    "operational_health": { "$ref": "#/$defs/health" },
    "attribution_entries": { "type": "array", "items": { "$ref": "#/$defs/attributionEntry" } },
    "schedules": { "type": "array", "items": { "$ref": "#/$defs/schedule" } }
  },
  "$defs": {
    "canonicalId": { "type": "string", "pattern": "^[a-z0-9._-]+$", "minLength": 1 },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "decimal": { "type": "string", "pattern": "^-?[0-9]+(?:\\.[0-9]{1,8})?$" },
    "utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "account": { "type": "object", "additionalProperties": false, "required": ["account_id", "currency"], "properties": { "account_id": { "$ref": "#/$defs/canonicalId" }, "currency": { "pattern": "^[A-Z]{3}$" } } },
    "configuration": { "type": "object", "additionalProperties": false, "required": ["configuration_id", "configuration_version"], "properties": { "configuration_id": { "$ref": "#/$defs/canonicalId" }, "configuration_version": { "type": "string", "minLength": 1 } } },
    "reproducibility": { "type": "object", "additionalProperties": false, "required": ["strategy_id", "strategy_version", "strategy_bundle_hash", "dataset_id", "dataset_version", "dataset_hash", "replay_event_hash"], "properties": { "strategy_id": { "$ref": "#/$defs/canonicalId" }, "strategy_version": { "type": "string", "minLength": 1 }, "strategy_bundle_hash": { "$ref": "#/$defs/hash" }, "dataset_id": { "$ref": "#/$defs/canonicalId" }, "dataset_version": { "type": "string", "minLength": 1 }, "dataset_hash": { "$ref": "#/$defs/hash" }, "replay_event_hash": { "$ref": "#/$defs/hash" } } },
    "parameters": { "type": "object", "additionalProperties": false, "required": ["parameter_set_id", "revision", "previous_revision", "previous_parameter_set_fingerprint", "values"], "properties": { "parameter_set_id": { "$ref": "#/$defs/canonicalId" }, "revision": { "$ref": "#/$defs/canonicalId" }, "previous_revision": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/canonicalId" }] }, "previous_parameter_set_fingerprint": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/hash" }] }, "values": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/parameter" } } } },
    "parameter": { "type": "object", "additionalProperties": false, "required": ["parameter_id", "value", "minimum", "maximum", "control", "approval"], "properties": { "parameter_id": { "$ref": "#/$defs/canonicalId" }, "value": { "$ref": "#/$defs/decimal" }, "minimum": { "$ref": "#/$defs/decimal" }, "maximum": { "$ref": "#/$defs/decimal" }, "control": { "enum": ["STANDARD", "TWO_PERSON"] }, "approval": { "oneOf": [ { "type": "null" }, { "$ref": "#/$defs/approval" } ] } } },
    "approval": { "type": "object", "additionalProperties": false, "required": ["approval_id", "requested_by", "approved_by", "approved_at", "approval_subject_hash", "authorization_policy_hash", "approval_evidence_hash"], "properties": { "approval_id": { "$ref": "#/$defs/canonicalId" }, "requested_by": { "$ref": "#/$defs/canonicalId" }, "approved_by": { "$ref": "#/$defs/canonicalId" }, "approved_at": { "$ref": "#/$defs/utc" }, "approval_subject_hash": { "$ref": "#/$defs/hash" }, "authorization_policy_hash": { "$ref": "#/$defs/hash" }, "approval_evidence_hash": { "$ref": "#/$defs/hash" } } },
    "valuation": { "type": "object", "additionalProperties": false, "required": ["starting_equity", "cash", "peak_equity"], "properties": { "starting_equity": { "$ref": "#/$defs/decimal" }, "cash": { "$ref": "#/$defs/decimal" }, "peak_equity": { "$ref": "#/$defs/decimal" } } },
    "position": { "type": "object", "additionalProperties": false, "required": ["instrument_id", "quantity", "mark_price", "average_cost", "realized_pnl"], "properties": { "instrument_id": { "$ref": "#/$defs/canonicalId" }, "quantity": { "$ref": "#/$defs/decimal" }, "mark_price": { "$ref": "#/$defs/decimal" }, "average_cost": { "$ref": "#/$defs/decimal" }, "realized_pnl": { "$ref": "#/$defs/decimal" } } },
    "riskLimits": { "type": "object", "additionalProperties": false, "required": ["max_gross_exposure", "max_single_instrument_exposure", "max_drawdown_bps", "max_working_orders", "max_unknown_orders", "max_unresolved_incidents"], "properties": { "max_gross_exposure": { "$ref": "#/$defs/decimal" }, "max_single_instrument_exposure": { "$ref": "#/$defs/decimal" }, "max_drawdown_bps": { "$ref": "#/$defs/decimal" }, "max_working_orders": { "type": "integer", "minimum": 0 }, "max_unknown_orders": { "type": "integer", "minimum": 0 }, "max_unresolved_incidents": { "type": "integer", "minimum": 0 } } },
    "health": { "type": "object", "additionalProperties": false, "required": ["audit_healthy", "reconciliation_healthy", "broker_connected", "active_kill_switches", "working_orders", "unknown_orders", "unresolved_incidents"], "properties": { "audit_healthy": { "type": "boolean" }, "reconciliation_healthy": { "type": "boolean" }, "broker_connected": { "type": "boolean" }, "active_kill_switches": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 256 } }, "working_orders": { "type": "integer", "minimum": 0 }, "unknown_orders": { "type": "integer", "minimum": 0 }, "unresolved_incidents": { "type": "integer", "minimum": 0 } } },
    "attributionEntry": { "type": "object", "additionalProperties": false, "required": ["entry_id", "occurred_at", "instrument_id", "category", "amount"], "properties": { "entry_id": { "$ref": "#/$defs/canonicalId" }, "occurred_at": { "$ref": "#/$defs/utc" }, "instrument_id": { "$ref": "#/$defs/canonicalId" }, "category": { "enum": ["REALIZED_PNL", "UNREALIZED_PNL", "FEES", "DIVIDENDS", "CORPORATE_ACTIONS"] }, "amount": { "$ref": "#/$defs/decimal" } } },
    "schedule": { "type": "object", "additionalProperties": false, "required": ["schedule_id", "purpose", "time_utc", "enabled", "last_completed_at"], "properties": { "schedule_id": { "$ref": "#/$defs/canonicalId" }, "purpose": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\r\\n]+$" }, "time_utc": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" }, "enabled": { "type": "boolean" }, "last_completed_at": { "oneOf": [ { "type": "null" }, { "$ref": "#/$defs/utc" } ] } } }
  }
}

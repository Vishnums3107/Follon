{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AdapterQualification",
  "description": "Venue and provider adapter qualification record certifying supported market capabilities, single-writer fencing, and reconciliation gates (LIFE-07, PORT-02).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "qualification_schema_version",
    "qualification_id",
    "venue",
    "asset_class",
    "adapter_version",
    "supported_capabilities",
    "single_writer_fenced",
    "reconciliation_pass_rate_pct",
    "operational_gate_status",
    "created_at",
    "expires_at"
  ],
  "properties": {
    "qualification_schema_version": {
      "type": "integer",
      "enum": [1]
    },
    "qualification_id": {
      "type": "string",
      "pattern": "^qual\\.[a-z0-9_.-]+$"
    },
    "venue": { "type": "string" },
    "asset_class": {
      "type": "string",
      "enum": ["US_EQUITY", "EQUITY_OPTION", "SPOT_FX", "COMMODITY_FUTURES"]
    },
    "adapter_version": { "type": "string" },
    "supported_capabilities": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "single_writer_fenced": { "type": "boolean" },
    "reconciliation_pass_rate_pct": { "type": "string" },
    "operational_gate_status": {
      "type": "string",
      "enum": ["QUALIFIED", "PROVISIONAL", "EXPIRED", "REVOKED"]
    },
    "created_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" }
  }
}

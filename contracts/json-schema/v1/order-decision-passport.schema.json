{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OrderDecisionPassport",
  "description": "Complete attributable decision passport connecting opportunity signal, policy inputs, risk evaluation, OMS routing, executions, fees, and ledger impact (EXEC-02).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "passport_schema_version",
    "passport_id",
    "intent_id",
    "order_id",
    "instrument_id",
    "signal_attribution",
    "risk_evaluation",
    "routing_plan",
    "executions",
    "accounting_consequences",
    "created_at"
  ],
  "properties": {
    "passport_schema_version": {
      "type": "integer",
      "enum": [1]
    },
    "passport_id": {
      "type": "string",
      "pattern": "^passport\\.[a-z0-9_.-]+$"
    },
    "intent_id": { "type": "string" },
    "order_id": { "type": "string" },
    "instrument_id": { "type": "string" },
    "signal_attribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy_version", "model_event_id", "opportunity_description", "signal_power_bps"],
      "properties": {
        "strategy_version": { "type": "string" },
        "model_event_id": { "type": "string" },
        "opportunity_description": { "type": "string" },
        "signal_power_bps": { "type": "integer" }
      }
    },
    "risk_evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_version", "approved", "evaluated_limits", "headroom_remaining_bps"],
      "properties": {
        "policy_version": { "type": "string" },
        "approved": { "type": "boolean" },
        "evaluated_limits": { "type": "array", "items": { "type": "string" } },
        "headroom_remaining_bps": { "type": "integer" }
      }
    },
    "routing_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "allocated_slices_count", "primary_venue", "capability_version"],
      "properties": {
        "algorithm": { "type": "string" },
        "allocated_slices_count": { "type": "integer", "minimum": 1 },
        "primary_venue": { "type": "string" },
        "capability_version": { "type": "string" }
      }
    },
    "executions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["execution_id", "venue", "quantity", "price", "fee", "executed_at"],
        "properties": {
          "execution_id": { "type": "string" },
          "venue": { "type": "string" },
          "quantity": { "type": "string" },
          "price": { "type": "string" },
          "fee": { "type": "string" },
          "executed_at": { "type": "string", "format": "date-time" }
        }
      }
    },
    "accounting_consequences": {
      "type": "object",
      "additionalProperties": false,
      "required": ["journal_entry_id", "realized_pnl", "cash_delta", "position_after"],
      "properties": {
        "journal_entry_id": { "type": "string" },
        "realized_pnl": { "type": "string" },
        "cash_delta": { "type": "string" },
        "position_after": { "type": "string" }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}

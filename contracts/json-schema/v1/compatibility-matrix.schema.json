{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CompatibilityMatrix",
  "description": "Multi-year schema version compatibility matrix recording supported schemas, reader functions, and migration proofs (DUR-12).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "compatibility_schema_version",
    "matrix_id",
    "engine_version",
    "registered_schemas",
    "backward_compatibility_verified",
    "golden_corpus_size",
    "verified_at"
  ],
  "properties": {
    "compatibility_schema_version": {
      "type": "integer",
      "enum": [1]
    },
    "matrix_id": {
      "type": "string",
      "pattern": "^compat\\.[a-z0-9_.-]+$"
    },
    "engine_version": { "type": "string" },
    "registered_schemas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_name",
          "current_version",
          "oldest_supported_version",
          "migration_status"
        ],
        "properties": {
          "schema_name": { "type": "string" },
          "current_version": { "type": "integer", "minimum": 1 },
          "oldest_supported_version": { "type": "integer", "minimum": 1 },
          "migration_status": {
            "type": "string",
            "enum": ["CURRENT", "AUTOMATIC_UPGRADE", "DEPRECATED"]
          }
        }
      }
    },
    "backward_compatibility_verified": { "type": "boolean" },
    "golden_corpus_size": { "type": "integer", "minimum": 0 },
    "verified_at": { "type": "string", "format": "date-time" }
  }
}

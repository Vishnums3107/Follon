{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://follon.dev/contracts/v1/options-configuration.schema.json",
  "title": "Follon Deterministic European Options Configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "reconciled_at", "chain", "risk_free_rate", "strategy", "expiry_scenarios", "books"],
  "properties": {
    "schema_version": { "const": 1 },
    "reconciled_at": { "$ref": "#/$defs/utc" },
    "chain": { "$ref": "#/$defs/chain" },
    "risk_free_rate": { "$ref": "#/$defs/decimal" },
    "strategy": { "$ref": "#/$defs/strategy" },
    "expiry_scenarios": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/decimal" } },
    "books": { "$ref": "#/$defs/books" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9._-]+$", "minLength": 1 },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "decimal": { "type": "string", "pattern": "^-?[0-9]+(?:\\.[0-9]{1,8})?$" },
    "utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "runIdentity": { "type": "object", "additionalProperties": false, "required": ["strategy_bundle_hash", "configuration_hash", "dataset_hash", "replay_event_hash", "chain_snapshot_hash", "model_version"], "properties": { "strategy_bundle_hash": { "$ref": "#/$defs/hash" }, "configuration_hash": { "$ref": "#/$defs/hash" }, "dataset_hash": { "$ref": "#/$defs/hash" }, "replay_event_hash": { "$ref": "#/$defs/hash" }, "chain_snapshot_hash": { "$ref": "#/$defs/hash" }, "model_version": { "const": "follon-european-black-scholes-fixed-v1" } } },
    "chain": { "type": "object", "additionalProperties": false, "required": ["chain_id", "underlying_instrument_id", "snapshot_at", "underlying_mark", "reference_version", "contracts", "quotes"], "properties": { "chain_id": { "$ref": "#/$defs/id" }, "underlying_instrument_id": { "$ref": "#/$defs/id" }, "snapshot_at": { "$ref": "#/$defs/utc" }, "underlying_mark": { "$ref": "#/$defs/decimal" }, "reference_version": { "$ref": "#/$defs/id" }, "contracts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/contract" } }, "quotes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/quote" } } } },
    "contract": { "type": "object", "additionalProperties": false, "required": ["option_id", "underlying_instrument_id", "expiration_at", "strike", "right", "multiplier", "currency", "reference_version"], "properties": { "option_id": { "$ref": "#/$defs/id" }, "underlying_instrument_id": { "$ref": "#/$defs/id" }, "expiration_at": { "$ref": "#/$defs/utc" }, "strike": { "$ref": "#/$defs/decimal" }, "right": { "enum": ["CALL", "PUT"] }, "multiplier": { "$ref": "#/$defs/decimal" }, "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }, "reference_version": { "$ref": "#/$defs/id" } } },
    "quote": { "type": "object", "additionalProperties": false, "required": ["option_id", "observed_at", "bid", "ask", "last", "volume", "open_interest"], "properties": { "option_id": { "$ref": "#/$defs/id" }, "observed_at": { "$ref": "#/$defs/utc" }, "bid": { "$ref": "#/$defs/decimal" }, "ask": { "$ref": "#/$defs/decimal" }, "last": { "$ref": "#/$defs/decimal" }, "volume": { "type": "integer", "minimum": 0 }, "open_interest": { "type": "integer", "minimum": 0 } } },
    "strategy": { "type": "object", "additionalProperties": false, "required": ["strategy_id", "strategy_version", "legs"], "properties": { "strategy_id": { "$ref": "#/$defs/id" }, "strategy_version": { "type": "string", "minLength": 1 }, "legs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/leg" } } } },
    "leg": { "type": "object", "additionalProperties": false, "required": ["leg_id", "option_id", "side", "quantity", "entry_premium"], "properties": { "leg_id": { "$ref": "#/$defs/id" }, "option_id": { "$ref": "#/$defs/id" }, "side": { "enum": ["LONG", "SHORT"] }, "quantity": { "$ref": "#/$defs/decimal" }, "entry_premium": { "$ref": "#/$defs/decimal" } } },
    "books": { "type": "object", "additionalProperties": false, "required": ["backtest", "paper", "live"], "properties": { "backtest": { "$ref": "#/$defs/book" }, "paper": { "$ref": "#/$defs/book" }, "live": { "$ref": "#/$defs/book" } } },
    "book": { "type": "object", "additionalProperties": false, "required": ["account_id", "source_export_id", "source_export_hash", "as_of", "currency", "run_identity", "cash", "positions"], "properties": { "account_id": { "$ref": "#/$defs/id" }, "source_export_id": { "$ref": "#/$defs/id" }, "source_export_hash": { "$ref": "#/$defs/hash" }, "as_of": { "$ref": "#/$defs/utc" }, "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }, "run_identity": { "$ref": "#/$defs/runIdentity" }, "cash": { "$ref": "#/$defs/decimal" }, "positions": { "type": "array", "items": { "$ref": "#/$defs/bookPosition" } } } },
    "bookPosition": { "type": "object", "additionalProperties": false, "required": ["option_id", "quantity", "average_entry_premium", "mark_premium", "realized_pnl"], "properties": { "option_id": { "$ref": "#/$defs/id" }, "quantity": { "$ref": "#/$defs/decimal" }, "average_entry_premium": { "$ref": "#/$defs/decimal" }, "mark_premium": { "$ref": "#/$defs/decimal" }, "realized_pnl": { "$ref": "#/$defs/decimal" } } }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://follon.dev/contracts/v1/commercial-retention-plan.schema.json",
  "title": "Follon Hash-Bound Retention Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["retention_plan_schema_version", "tenant_id", "privacy_request_id", "as_of", "candidates", "withheld_asset_ids"],
  "properties": {
    "retention_plan_schema_version": { "const": 1 },
    "tenant_id": { "$ref": "#/$defs/id" },
    "privacy_request_id": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/id" }] },
    "as_of": { "$ref": "#/$defs/utc" },
    "candidates": { "type": "array", "items": { "$ref": "#/$defs/candidate" } },
    "withheld_asset_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9._-]+$", "minLength": 1 },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "relativePath": { "type": "string", "pattern": "^(?!.*(?:^|[\\/])\\.{1,2}(?:[\\/]|$))(?![\\/])[A-Za-z0-9._/-]+$", "minLength": 1, "maxLength": 4096 },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "relative_path", "classification", "reason", "expected_hash", "expected_bytes"],
      "properties": {
        "asset_id": { "$ref": "#/$defs/id" },
        "relative_path": { "$ref": "#/$defs/relativePath" },
        "classification": { "enum": ["CUSTOMER_CONTENT", "OPERATIONAL_METADATA", "MARKET_DATA", "AUDIT_EVIDENCE"] },
        "reason": { "enum": ["RETENTION_EXPIRED", "PRIVACY_ERASURE"] },
        "expected_hash": { "$ref": "#/$defs/hash" },
        "expected_bytes": { "type": "integer", "minimum": 0 }
      }
    }
  }
}

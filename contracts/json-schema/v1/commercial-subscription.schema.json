{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://follon.dev/contracts/v1/commercial-subscription.schema.json",
  "title": "Follon Externally Evidenced Subscription Observation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["commercial_subscription_schema_version", "subscription_id", "tenant_id", "plan", "status", "effective_at", "expires_at", "payment_provider", "external_customer_ref", "payment_evidence_hash"],
  "properties": {
    "commercial_subscription_schema_version": { "const": 1 },
    "subscription_id": { "$ref": "#/$defs/id" },
    "tenant_id": { "$ref": "#/$defs/id" },
    "plan": { "enum": ["PROFESSIONAL", "ORGANIZATION", "SELF_HOSTED"] },
    "status": { "enum": ["PAID", "GRACE", "SUSPENDED", "CANCELLED"] },
    "effective_at": { "$ref": "#/$defs/utc" },
    "expires_at": { "$ref": "#/$defs/utc" },
    "payment_provider": { "$ref": "#/$defs/id" },
    "external_customer_ref": { "$ref": "#/$defs/id" },
    "payment_evidence_hash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9._-]+$", "minLength": 1 },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" }
  }
}

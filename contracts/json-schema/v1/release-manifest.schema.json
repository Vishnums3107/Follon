{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://follon.dev/contracts/v1/release-manifest.schema.json",
  "title": "Follon Signed Release Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["release_manifest_schema_version", "release_id", "version", "created_at", "source_revision", "sbom_sha256", "artifacts"],
  "properties": {
    "release_manifest_schema_version": { "const": 1 },
    "release_id": { "$ref": "#/$defs/id" },
    "version": { "type": "string", "pattern": "^[A-Za-z0-9.+-]+$", "minLength": 1, "maxLength": 128 },
    "created_at": { "$ref": "#/$defs/utc" },
    "source_revision": { "type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$" },
    "sbom_sha256": { "$ref": "#/$defs/hash" },
    "artifacts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/artifact" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9._-]+$", "minLength": 1 },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "relativePath": { "type": "string", "pattern": "^(?!.*(?:^|[\\/])\\.{1,2}(?:[\\/]|$))(?![\\/])[A-Za-z0-9._/-]+$", "minLength": 1, "maxLength": 4096 },
    "artifact": { "type": "object", "additionalProperties": false, "required": ["artifact_id", "relative_path", "sha256", "bytes"], "properties": { "artifact_id": { "$ref": "#/$defs/id" }, "relative_path": { "$ref": "#/$defs/relativePath" }, "sha256": { "$ref": "#/$defs/hash" }, "bytes": { "type": "integer", "minimum": 1 } } }
  }
}

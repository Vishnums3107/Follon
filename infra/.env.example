# Local development only. Generate unique values; never commit infra/.env.
FOLLON_POSTGRES_PORT=5432
FOLLON_POSTGRES_PASSWORD=replace-with-a-local-development-password
FOLLON_MINIO_PASSWORD=replace-with-a-local-development-password
FOLLON_DASHBOARD_PORT=8080
# Development may leave both blank. Production mode requires both and rejects
# passwords shorter than 16 characters. Put TLS in front of production Basic auth.
FOLLON_DASHBOARD_MODE=development
FOLLON_DASHBOARD_USERNAME=
FOLLON_DASHBOARD_PASSWORD=
# Preferred for the secure Compose overlay; use an absolute protected file.
FOLLON_DASHBOARD_PASSWORD_FILE=

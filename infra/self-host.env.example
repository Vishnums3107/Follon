# Copy to a host-local protected environment file. Do not commit populated values.
# The image reference must be an already verified local image digest; Compose is
# intentionally configured not to pull it from a registry.
FOLLON_ADMIN_IMAGE=follon-admin@sha256:<verified-image-digest>
FOLLON_SELF_HOST_ROOT=C:\follon-self-host\data
FOLLON_RELEASE_ROOT=C:\follon-self-host\release
FOLLON_CONFIG_ROOT=C:\follon-self-host\config

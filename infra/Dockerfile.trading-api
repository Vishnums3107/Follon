FROM rust:1.85-bookworm AS build
WORKDIR /workspace
COPY Cargo.toml Cargo.lock ./
COPY core/ core/
COPY adapters/ adapters/
COPY services/ services/
COPY contracts/ contracts/
RUN cargo build --locked --release -p follon-trading-api

FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates libssl3 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 10001 --no-create-home follon
COPY --from=build /workspace/target/release/follon-trading-api /usr/local/bin/follon-trading-api
USER 10001:10001
EXPOSE 50051
ENTRYPOINT ["/usr/local/bin/follon-trading-api"]

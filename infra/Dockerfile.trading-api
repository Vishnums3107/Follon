FROM rust:1.97-bookworm AS build
WORKDIR /workspace
COPY Cargo.toml Cargo.lock ./
COPY core/ core/
COPY adapters/ adapters/
COPY services/ services/
COPY contracts/ contracts/
# `apps/cli` is not a follon-trading-api dependency, but it is a workspace
# member declared in the root Cargo.toml, so Cargo must be able to read its
# manifest to resolve the workspace at all -- even a `-p`-scoped build fails
# closed with "failed to load manifest for workspace member" without it.
COPY apps/cli apps/cli
RUN cargo build --locked --release -p follon-trading-api

FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates libssl3 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 10001 --no-create-home follon
COPY --from=build /workspace/target/release/follon-trading-api /usr/local/bin/follon-trading-api
USER 10001:10001
EXPOSE 50051
ENTRYPOINT ["/usr/local/bin/follon-trading-api"]
